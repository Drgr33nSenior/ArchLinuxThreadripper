# Family interface. Keep configuration in source, not the persistent Admin UI.
WEBUI_NAME=Family AI
DEFAULT_USER_ROLE=user
ENABLE_PERSISTENT_CONFIG=false
ENABLE_SIGNUP=false
ENABLE_FORWARD_USER_INFO_HEADERS=true
ENABLE_DIRECT_CONNECTIONS=false
ENABLE_IMAGE_PROMPT_GENERATION=false
DEFAULT_PROMPT_SUGGESTIONS=[{"title":["Explain something","in everyday language"],"content":"Help me understand a topic. Ask what I already know, then explain it with an example."},{"title":["Plan something","together"],"content":"Help me plan something. Ask about the goal, available time and constraints first."},{"title":["Work with a document","and show the evidence"],"content":"Help me answer questions about an attached document. Cite the relevant passages and say when the document does not contain the answer."},{"title":["Write or improve","a piece of text"],"content":"Help me write something. Ask about the audience and the tone I want."}]
# Browser speech synthesis is available without loading another GPU model.
# Voice input uses Open WebUI's local faster-whisper on the CPU (WHISPER_MODEL in the
# rag overlay; `rag stage-whisper`), so audio never leaves the workstation.
# Qwen ASR/TTS require separate qualified runtimes; do not fall back to a cloud API.
AUDIO_TTS_ENGINE=
AUDIO_STT_OPENAI_API_BASE_URL=
AUDIO_STT_OPENAI_API_KEY=
AUDIO_TTS_OPENAI_API_BASE_URL=
AUDIO_TTS_OPENAI_API_KEY=
USER_PERMISSIONS_CHAT_STT=true
WHISPER_MODEL_AUTO_UPDATE=false
