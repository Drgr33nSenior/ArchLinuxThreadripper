# Assistant retrieval profile, merged over apps/overlays/rag/rag.env. Hybrid
# BM25/vector candidates are reranked in-process on CPU by the reviewed
# cross-encoder (versions.lock RAG_RERANKER_*, apps/overlays/rag/RERANKER-SHA256SUMS).
# Rollback: remove this component from the assistant overlays (docs/RAG.md).
RAG_RERANKER_PROFILE=ms-marco-minilm-l6-v2
RAG_RERANKING_ENGINE=
RAG_RERANKING_MODEL=/rag-models/ms-marco-MiniLM-L6-v2
# Pairs per forward pass. The model's 512-token pair limit is fixed by its
# hash-pinned tokenizer_config.json; Open WebUI 0.13.3 has no max-length setting.
RAG_RERANKING_BATCH_SIZE=8
# Open WebUI loads a reranker only while hybrid search is enabled.
ENABLE_RAG_HYBRID_SEARCH=true
# At most 2 x RAG_TOP_K = 20 unique BM25/vector candidates are scored per
# collection; RAG_TOP_K_RERANKER = 5 final passages are kept.
RAG_TOP_K=10
RAG_TOP_K_RERANKER=5
# 0.0 disables score filtering (upstream skips a zero threshold).
RAG_RELEVANCE_THRESHOLD=0.0
# Five passages at up to 1,600 characters each for the MCP tool.
RAG_CONTEXT_CHAR_BUDGET=8000
