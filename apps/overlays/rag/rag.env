# Open WebUI 0.11.3 CPU pilot. Edit here, not in the persistent Admin UI.
ENABLE_PERSISTENT_CONFIG=false
UVICORN_WORKERS=1
VECTOR_DB=chroma
USE_CUDA_DOCKER=false
RAG_EMBEDDING_ENGINE=
RAG_EMBEDDING_MODEL=/rag-models/Qwen3-Embedding-0.6B
RAG_EMBEDDING_MODEL_AUTO_UPDATE=false
RAG_EMBEDDING_MODEL_TRUST_REMOTE_CODE=false
RAG_EMBEDDING_BATCH_SIZE=1
ENABLE_ASYNC_EMBEDDING=false
RAG_RERANKING_ENGINE=
RAG_RERANKING_MODEL=
RAG_RERANKING_MODEL_AUTO_UPDATE=false
RAG_RERANKING_MODEL_TRUST_REMOTE_CODE=false
ENABLE_RAG_HYBRID_SEARCH=true
RAG_HYBRID_BM25_WEIGHT=0.5
RAG_TOP_K=3
RAG_TOP_K_RERANKER=3
RAG_FULL_CONTEXT=false
ENABLE_RETRIEVAL_QUERY_GENERATION=false
# Keep this initial comparison corpus shape fixed while Qwen supports a longer
# embedding context.  These are chunking tokens, not serving-context tokens.
RAG_TEXT_SPLITTER=token_transformers
RAG_TOKENIZER_MODEL=/rag-models/Qwen3-Embedding-0.6B
CHUNK_SIZE=192
CHUNK_OVERLAP=32
RAG_FILE_MAX_SIZE=2
RAG_FILE_MAX_COUNT=1
RAG_ALLOWED_FILE_EXTENSIONS=md,txt
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false
HF_HUB_DISABLE_TELEMETRY=1
ANONYMIZED_TELEMETRY=false
