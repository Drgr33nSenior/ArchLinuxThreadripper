# Shared Open WebUI RAG profile: 0.11.4 in the rag/service overlays, 0.12.5 in the
# assistant overlays, where apps/components/rag-reranker merges its reranker
# settings over this baseline. Edit here, not in the persistent Admin UI.
ENABLE_PERSISTENT_CONFIG=false
UVICORN_WORKERS=1
VECTOR_DB=chroma
USE_CUDA_DOCKER=false
RAG_EMBEDDING_ENGINE=
RAG_EMBEDDING_MODEL=/rag-models/Qwen3-Embedding-0.6B
RAG_EMBEDDING_MODEL_AUTO_UPDATE=false
RAG_EMBEDDING_MODEL_TRUST_REMOTE_CODE=false
RAG_EMBEDDING_BATCH_SIZE=1
ENABLE_ASYNC_EMBEDDING=false
# Baseline (and rollback) mode: no cross-encoder; hybrid candidates are rescored
# by embedding cosine. validate-profile.sh enforces each named profile.
RAG_RERANKER_PROFILE=none
RAG_RERANKING_ENGINE=
RAG_RERANKING_MODEL=
RAG_RERANKING_MODEL_AUTO_UPDATE=false
RAG_RERANKING_MODEL_TRUST_REMOTE_CODE=false
ENABLE_RAG_HYBRID_SEARCH=true
RAG_HYBRID_BM25_WEIGHT=0.5
# RAG_TOP_K: candidates per retriever (BM25 and vector), also the cross-collection
# merge limit. RAG_TOP_K_RERANKER: final passages per collection. Browser chat and
# the service-tools MCP tool both read these values; neither adds its own count.
RAG_TOP_K=3
RAG_TOP_K_RERANKER=3
RAG_RELEVANCE_THRESHOLD=0.0
RAG_FULL_CONTEXT=false
ENABLE_RETRIEVAL_QUERY_GENERATION=false
# Keep this initial comparison corpus shape fixed while Qwen supports a longer
# embedding context.  These are chunking tokens, not serving-context tokens.
RAG_TEXT_SPLITTER=token_transformers
RAG_TOKENIZER_MODEL=/rag-models/Qwen3-Embedding-0.6B
CHUNK_SIZE=192
CHUNK_OVERLAP=32
RAG_FILE_MAX_SIZE=2
RAG_FILE_MAX_COUNT=1
RAG_ALLOWED_FILE_EXTENSIONS=md,txt
# Returned-text allowance for the service-tools MCP tools, in characters of source
# text. Separate from embedding/reranker token limits and from the serving model's
# context; measure the final prompt with the serving tokenizer.
RAG_PASSAGE_CHAR_LIMIT=1600
RAG_CONTEXT_CHAR_BUDGET=4800
RAG_EXPANSION_CHAR_LIMIT=800
RAG_SOURCE_READ_CHAR_LIMIT=8000
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false
TIKTOKEN_CACHE_DIR=/runtime-tiktoken
HF_HUB_DISABLE_TELEMETRY=1
ANONYMIZED_TELEMETRY=false
