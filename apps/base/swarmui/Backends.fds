0:
    type: comfyui_selfstart
    enabled: true
    title: Packaged ROCm ComfyUI
    settings:
        StartScript: /SwarmUI/dlbackend/ComfyUI/main.py
        GPU_ID: 0
        AutoUpdate: false
        UpdateManagedNodes: false
        FrontendVersion: None
        ExtraArgs: --output-directory /SwarmUI/Output/comfy --temp-directory /tmp/comfy-temp --input-directory /SwarmUI/Data/comfy-input --user-directory /SwarmUI/Data/comfy-user --extra-model-paths-config /config/image-model-paths.yaml --reserve-vram 1.5 --vram-headroom 2 --fast-disk --use-ck-attention
        OverQueue: 0
1:
    type: comfyui_api
    enabled: true
    title: ComfyUI on gpu-0 (shared mode)
    settings:
        Address: http://comfyui-gpu0:7821
        AllowIdle: true
        OverQueue: 0
        EnableFrontendDev: false
