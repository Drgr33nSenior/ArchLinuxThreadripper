  "schemaVersion": 39,
  "version": 1,
  "uid": "workstation-kubernetes",
  "title": "Workstation / Kubernetes cluster",
  "description": "Node, Pod, deployment, allocation and storage health for the single-node K3s cluster.",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Kubernetes namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(kube_pod_status_phase{job=\"kube-state-metrics\"}, namespace)",
        "query": {
          "query": "label_values(kube_pod_status_phase{job=\"kube-state-metrics\"}, namespace)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Cluster status and coverage",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**K3s on this workstation.** Select a namespace for Pod, workload and storage views; node capacity covers the whole single-node cluster. Use **Pods** above for a selected Pod, or **Serving** for model latency. All current namespaces with Pods are included, plus `ai-home-lab`. Completed diagnostic Pods are retained and counted separately below.\n\nContainer requests are declared regular-container budgets, not actual use or the scheduler's effective reservation. API-server/etcd latency, Kubernetes Events, arbitrary Pod logs, PVC filesystem usage and DaemonSet/StatefulSet desired-state metrics are **not collected**."
      }
    },
    {
      "id": 2,
      "title": "Ready nodes",
      "type": "stat",
      "description": "Nodes currently reporting Ready=true.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_node_status_condition{job=\"kube-state-metrics\",condition=\"Ready\",status=\"true\"})",
          "legendFormat": "Ready",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Running Pods",
      "type": "stat",
      "description": "Current running Pods in the selected namespaces; completed history is excluded.",
      "gridPos": {
        "x": 4,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_phase{job=\"kube-state-metrics\",namespace=~\"${namespace:regex}\",phase=\"Running\"})",
          "legendFormat": "Running",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Pending Pods",
      "type": "stat",
      "description": "Pending includes scheduling and startup; use the Pod waiting/unschedulable views for the cause.",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_phase{job=\"kube-state-metrics\",namespace=~\"${namespace:regex}\",phase=\"Pending\"})",
          "legendFormat": "Pending",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Active Pods not Ready",
      "type": "stat",
      "description": "Pending/Running/Unknown Pods with Ready=false or unknown. Retained terminal Pods do not inflate this count.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_ready{job=\"kube-state-metrics\",namespace=~\"${namespace:regex}\",condition=~\"false|unknown\"} and on(namespace,pod) (kube_pod_status_phase{job=\"kube-state-metrics\",namespace=~\"${namespace:regex}\",phase=~\"Pending|Running|Unknown\"} == 1)) or (0 * sum(kube_pod_status_phase{job=\"kube-state-metrics\",namespace=~\"${namespace:regex}\",phase=~\"Pending|Running|Unknown\"}))",
          "legendFormat": "Not Ready",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "GPU allocation slots · node",
      "type": "stat",
      "description": "Kubernetes allocatable amd.com/gpu slots across the node, not free VRAM or proof of device ownership.",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_node_status_allocatable{job=\"kube-state-metrics\",resource=\"amd_com_gpu\"})",
          "legendFormat": "Allocatable",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "title": "Object-state collector",
      "type": "stat",
      "description": "A successful object-metric scrape is not API-server or etcd health qualification.",
      "gridPos": {
        "x": 20,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"kube-state-metrics\"}",
          "legendFormat": "Scrape up",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 8,
      "title": "Node conditions · current state",
      "type": "table",
      "description": "Each row names the active true/false/unknown state. Pressure=false and Ready=true are normally expected.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_node_status_condition{job=\"kube-state-metrics\"} == 1",
          "legendFormat": "{{node}} · {{condition}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 9,
      "title": "Scheduling disabled on node",
      "type": "table",
      "description": "1 means the node is cordoned. No cordon/uncordon action is available from this dashboard.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_node_spec_unschedulable{job=\"kube-state-metrics\"}",
          "legendFormat": "{{node}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 10,
      "title": "Active Pods by phase",
      "type": "timeseries",
      "description": "Current phase counts; successful and failed retained Pods appear separately below.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (phase) (kube_pod_status_phase{job=\"kube-state-metrics\",namespace=~\"${namespace:regex}\",phase=~\"Pending|Running|Unknown\"})",
          "legendFormat": "{{phase}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never",
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "title": "Deployment replicas · desired and available",
      "type": "table",
      "description": "Zero desired replicas can be intentional. Deployment metrics do not cover DaemonSets or StatefulSets.",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(kube_deployment_spec_replicas{job=\"kube-state-metrics\",namespace=~\"${namespace:regex}\"},\"replica_state\",\"desired\",\"__name__\",\".*\") or label_replace(kube_deployment_status_replicas_available{job=\"kube-state-metrics\",namespace=~\"${namespace:regex}\"},\"replica_state\",\"available\",\"__name__\",\".*\")",
          "legendFormat": "{{namespace}} / {{deployment}} · {{replica_state}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 12,
      "title": "CPU requests and node allocatable",
      "type": "timeseries",
      "description": "Requests cover regular containers in active selected Pods; exclude init containers, Pod-level resources and overhead. Allocatable is cluster-wide; neither line is actual CPU use.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_container_resource_requests{job=\"kube-state-metrics\",namespace=~\"${namespace:regex}\",resource=\"cpu\"} and on(namespace,pod) (kube_pod_status_phase{job=\"kube-state-metrics\",namespace=~\"${namespace:regex}\",phase=~\"Pending|Running|Unknown\"} == 1))",
          "legendFormat": "Selected Pod requests",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum(kube_node_status_allocatable{job=\"kube-state-metrics\",resource=\"cpu\"})",
          "legendFormat": "Node allocatable",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never",
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "title": "Memory requests and node allocatable",
      "type": "timeseries",
      "description": "Regular-container memory requests in active selected Pods versus node allocatable. This is not host MemAvailable or actual working set.",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_container_resource_requests{job=\"kube-state-metrics\",namespace=~\"${namespace:regex}\",resource=\"memory\"} and on(namespace,pod) (kube_pod_status_phase{job=\"kube-state-metrics\",namespace=~\"${namespace:regex}\",phase=~\"Pending|Running|Unknown\"} == 1))",
          "legendFormat": "Selected Pod requests",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum(kube_node_status_allocatable{job=\"kube-state-metrics\",resource=\"memory\"})",
          "legendFormat": "Node allocatable",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never",
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "title": "GPU requests · active Pods",
      "type": "table",
      "description": "Regular-container amd.com/gpu requests in active selected Pods; absent rows mean no matching requests. This does not authorize GPU use or account for init-container resource semantics.",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_container_resource_requests{job=\"kube-state-metrics\",namespace=~\"${namespace:regex}\",resource=\"amd_com_gpu\"} and on(namespace,pod) (kube_pod_status_phase{job=\"kube-state-metrics\",namespace=~\"${namespace:regex}\",phase=~\"Pending|Running|Unknown\"} == 1)",
          "legendFormat": "{{namespace}} / {{pod}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 15,
      "title": "PersistentVolumeClaim phases",
      "type": "table",
      "description": "Bound is an allocation state, not filesystem usage, free disk space or a hard local-path quota.",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_persistentvolumeclaim_status_phase{job=\"kube-state-metrics\",namespace=~\"${namespace:regex}\"} == 1",
          "legendFormat": "{{namespace}} / {{persistentvolumeclaim}} · {{phase}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 16,
      "title": "PersistentVolumeClaim requested capacity",
      "type": "table",
      "description": "Requested storage only. Use Host for real filesystem capacity. Local-path requests are not enforced disk quotas.",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_persistentvolumeclaim_resource_requests_storage_bytes{job=\"kube-state-metrics\",namespace=~\"${namespace:regex}\"}",
          "legendFormat": "{{namespace}} / {{persistentvolumeclaim}}",
          "range": false,
