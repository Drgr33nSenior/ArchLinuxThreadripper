      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sglang:token_usage{job=\"sglang\"}",
          "legendFormat": "{{model_name}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 9,
      "title": "SGLang queued requests",
      "type": "timeseries",
      "description": "Queue depth helps distinguish demand from idle GPUs. Priority subtotals are excluded.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sglang:num_queue_reqs{job=\"sglang\",priority=\"\"}",
          "legendFormat": "{{model_name}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Generation token rate",
      "type": "timeseries",
      "description": "Rate of server generation-token counter per exported series. It is not per-request decode speed or verified delivered output.",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(sglang:generation_tokens_total{job=\"sglang\"}[$__rate_interval])",
          "legendFormat": "{{model_name}} \u00b7 {{instance}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Time to first token \u00b7 p50 / p95",
      "type": "timeseries",
      "description": "Observed histogram percentiles per model. Sparse traffic makes tail estimates unstable.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (model_name, le) (rate(sglang:time_to_first_token_seconds_bucket{job=\"sglang\"}[$__rate_interval])))",
          "legendFormat": "{{model_name}} p50",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (model_name, le) (rate(sglang:time_to_first_token_seconds_bucket{job=\"sglang\"}[$__rate_interval])))",
          "legendFormat": "{{model_name}} p95",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "Inter-token latency \u00b7 p50 / p95",
      "type": "timeseries",
      "description": "Server histogram timing. Speculative stream updates may contain multiple accepted tokens; do not invert a chunk gap to estimate throughput.",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (model_name, le) (rate(sglang:inter_token_latency_seconds_bucket{job=\"sglang\"}[$__rate_interval])))",
          "legendFormat": "{{model_name}} p50",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (model_name, le) (rate(sglang:inter_token_latency_seconds_bucket{job=\"sglang\"}[$__rate_interval])))",
          "legendFormat": "{{model_name}} p95",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 17,
      "title": "Speculative decoding \u00b7 accepted tokens per step",
      "type": "timeseries",
      "description": "Mean accepted draft tokens plus the bonus token per verify step (DFlash/MTP). Only exported when speculative decoding is enabled; a falling value means the draft model is predicting the target worse.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sglang:spec_accept_length{job=\"sglang\"}",
          "legendFormat": "{{model_name}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 18,
      "title": "Speculative accept rate \u00b7 prefix cache hit rate",
      "type": "timeseries",
      "description": "Share of drafted tokens accepted, and share of prompt tokens served from the prefix (radix) cache. A falling cache hit rate usually means prompts stopped sharing prefixes.",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sglang:spec_accept_rate{job=\"sglang\"}",
          "legendFormat": "accept rate \u00b7 {{model_name}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sglang:cache_hit_rate{job=\"sglang\"}",
          "legendFormat": "prefix cache hit \u00b7 {{model_name}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 19,
      "title": "End-to-end and queue latency \u00b7 p95",
      "type": "timeseries",
      "description": "95th percentile whole-request latency and time spent waiting in the scheduler queue. Queue time growing with end-to-end latency points at admission limits rather than kernel speed.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (model_name, le) (rate(sglang:e2e_request_latency_seconds_bucket{job=\"sglang\"}[$__rate_interval])))",
          "legendFormat": "end-to-end p95 \u00b7 {{model_name}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (model_name, le) (rate(sglang:queue_time_seconds_bucket{job=\"sglang\"}[$__rate_interval])))",
          "legendFormat": "queue p95 \u00b7 {{model_name}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 20,
      "title": "Retracted and aborted requests",
      "type": "timeseries",
      "description": "Requests retracted (preempted back to the queue when the KV pool runs out) and aborted, per interval. Retractions explain latency spikes that token throughput does not.",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model_name) (increase(sglang:num_retracted_requests_total{job=\"sglang\"}[$__rate_interval]))",
          "legendFormat": "retracted \u00b7 {{model_name}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum by (model_name) (increase(sglang:num_aborted_requests_total{job=\"sglang\"}[$__rate_interval]))",
          "legendFormat": "aborted \u00b7 {{model_name}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "title": "Container memory \u00b7 actual working set",
      "type": "timeseries",
