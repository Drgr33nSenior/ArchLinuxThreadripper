    {
      "id": 8,
      "title": "Negotiated PCIe link \u00b7 width and speed",
      "type": "stat",
      "description": "Current link width (lanes) and speed (GT/s) per GPU display function, from node-exporter's pcidevice collector. Full link: x16 at 32 GT/s (PCIe 5.0).",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_pcidevice_current_link_width{job=\"node\"} * on(segment,bus,device,function) group_left() node_pcidevice_info{job=\"node\",vendor_id=\"0x1002\",class_id=\"0x030000\"}",
          "legendFormat": "{{bus}} lanes",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_pcidevice_current_link_transfers_per_second{job=\"node\"} / 1e9 * on(segment,bus,device,function) group_left() node_pcidevice_info{job=\"node\",vendor_id=\"0x1002\",class_id=\"0x030000\"}",
          "legendFormat": "{{bus}} GT/s",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Telemetry unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 10,
      "title": "GPU identity",
      "type": "table",
      "description": "Card identity from AMD's device metrics exporter.",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (gpu_id, gpu_uuid, card_model, hostname) (gpu_total_vram{job=\"amd-gpu\",gpu_id=~\"${gpu:regex}\"})",
          "legendFormat": "GPU {{gpu_id}}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    }
  ]
