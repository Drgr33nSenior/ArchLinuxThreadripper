      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (gpu_id) (gpu_memory_temperature{job=\"amd-gpu\",gpu_id=~\"${gpu:regex}\"})",
          "legendFormat": "GPU {{gpu_id}} memory",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "max by (gpu_id) (gpu_edge_temperature{job=\"amd-gpu\",gpu_id=~\"${gpu:regex}\"})",
          "legendFormat": "GPU {{gpu_id}} edge",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "Exporter unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
