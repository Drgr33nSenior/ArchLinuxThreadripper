  "schemaVersion": 39,
  "version": 1,
  "uid": "workstation-gpus",
  "title": "Workstation / GPUs",
  "description": "Inspect one R9700 or compare separate PCI identities: activity, VRAM, sensors and clocks.",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "gpu",
        "label": "GPU \u00b7 PCI address",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(workstation_gpu_info{job=\"node\"}, pci_bdf)",
        "query": {
          "query": "label_values(workstation_gpu_info{job=\"node\"}, pci_bdf)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Reading this view",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Power, temperature, activity and clocks come from AMD's device metrics exporter, which keeps reading a card while it is runtime-suspended (idle). VRAM capacity, PCIe width and identity come from the workstation's sysfs sampler, whose activity and clock channels are unreadable while a card is runtime-suspended; the availability panel shows that, and it is not a fault. The PCI runtime power state is not a power reading: an idle card in D0 can draw as little as a suspended one, while a card driving a monitor draws more."
      }
    },
    {
      "id": 11,
      "title": "Activity / clock sensor availability",
      "type": "stat",
      "description": "Minimum readability of the busy/core-clock/memory-clock channels per card. 0 means at least one channel was unavailable, including when runtime-suspended; it does not imply a hardware fault or zero activity. No data means the fresh availability observation itself is missing.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (pci_bdf) (workstation_gpu_sensor_available{job=\"node\",pci_bdf=~\"${gpu:regex}\",sensor=~\"busy_percent|core_clock_hertz|memory_clock_hertz\"} and on(job,instance) (time() - workstation_hardware_sample_timestamp_seconds{job=\"node\"} <= 90) and on(job,instance) (workstation_hardware_sample_timestamp_seconds{job=\"node\"} - time() <= 10))",
          "legendFormat": "{{pci_bdf}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Telemetry unavailable",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable (may be asleep)",
                  "color": "text"
                },
                "1": {
                  "text": "Readable",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 12,
      "title": "PCI runtime power state",
      "type": "stat",
      "description": "The kernel's runtime power-management state per card: Active means the card is in PCI D0, Suspended means D3. It is not a power reading. An idle card in D0 can still draw about 1 W, because the driver gates its engines internally; use Package power for actual draw. A card driving a monitor stays in D0 and draws more. Until the updated sampler reports this directly, a card whose activity sensor is unreadable is shown as suspended.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{pci_bdf}}",
          "range": false,
          "instant": true,
          "expr": "max by (pci_bdf) (workstation_gpu_runtime_suspended{job=\"node\",pci_bdf=~\"${gpu:regex}\"}) or (1 - min by (pci_bdf) (workstation_gpu_sensor_available{job=\"node\",pci_bdf=~\"${gpu:regex}\",sensor=\"busy_percent\"} and on(job,instance) (time() - workstation_hardware_sample_timestamp_seconds{job=\"node\"} <= 90)))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Power state unavailable",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Active (D0)",
                  "color": "text"
                },
                "1": {
                  "text": "Suspended (D3)",
                  "color": "text"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 20,
      "title": "Package power \u00b7 each card",
      "type": "timeseries",
      "description": "Average package power. From AMD's device metrics exporter, which reads each card even while it is runtime-suspended; series are matched to the card's PCI address.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pci_bdf) (label_replace(gpu_average_package_power{job=\"amd-gpu\"}, \"card\", \"$1\", \"gpu_uuid\", \".*-([0-9a-f]{12})\") * on(card) group_left(pci_bdf) label_replace(workstation_gpu_info{job=\"node\",pci_bdf=~\"${gpu:regex}\"}, \"card\", \"$1\", \"unique_id\", \".*([0-9a-f]{12})\"))",
          "legendFormat": "{{pci_bdf}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "noValue": "Exporter unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 21,
      "title": "Junction (hotspot) temperature \u00b7 each card",
      "type": "timeseries",
      "description": "Hottest on-die point; the card throttles as this approaches its limit. From AMD's device metrics exporter, which reads each card even while it is runtime-suspended; series are matched to the card's PCI address.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pci_bdf) (label_replace(gpu_junction_temperature{job=\"amd-gpu\"}, \"card\", \"$1\", \"gpu_uuid\", \".*-([0-9a-f]{12})\") * on(card) group_left(pci_bdf) label_replace(workstation_gpu_info{job=\"node\",pci_bdf=~\"${gpu:regex}\"}, \"card\", \"$1\", \"unique_id\", \".*([0-9a-f]{12})\"))",
          "legendFormat": "{{pci_bdf}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "Exporter unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
