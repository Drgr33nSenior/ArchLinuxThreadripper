      "targets": [
        {
          "refId": "A",
          "expr": "workstation_gpu_vram_used_bytes{job=\"node\",pci_bdf=~\"${gpu:regex}\"} and on(job,instance) (time() - workstation_hardware_sample_timestamp_seconds{job=\"node\"} <= 90) and on(job,instance) (workstation_hardware_sample_timestamp_seconds{job=\"node\"} - time() <= 10)",
          "legendFormat": "{{pci_bdf}} used",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "workstation_gpu_vram_total_bytes{job=\"node\",pci_bdf=~\"${gpu:regex}\"} and on(job,instance) (time() - workstation_hardware_sample_timestamp_seconds{job=\"node\"} <= 90) and on(job,instance) (workstation_hardware_sample_timestamp_seconds{job=\"node\"} - time() <= 10)",
          "legendFormat": "{{pci_bdf}} total",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unavailable",
