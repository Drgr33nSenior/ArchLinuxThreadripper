          "refId": "A",
          "expr": "max by (pci_bdf) (label_replace(gpu_gfx_activity{job=\"amd-gpu\"}, \"card\", \"$1\", \"gpu_uuid\", \".*-([0-9a-f]{12})\") * on(card) group_left(pci_bdf) label_replace(workstation_gpu_info{job=\"node\",pci_bdf=~\"${gpu:regex}\"}, \"card\", \"$1\", \"unique_id\", \".*([0-9a-f]{12})\"))",
          "legendFormat": "{{pci_bdf}}",
