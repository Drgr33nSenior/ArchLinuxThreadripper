  "schemaVersion": 39,
  "version": 1,
  "uid": "workstation-gpus",
  "title": "Workstation / GPUs",
  "description": "Inspect one R9700 or compare separate PCI identities: activity, VRAM, sensors and clocks.",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "gpu",
        "label": "GPU",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(gpu_total_vram{job=\"amd-gpu\"}, gpu_id)",
        "query": {
          "query": "label_values(gpu_total_vram{job=\"amd-gpu\"}, gpu_id)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Reading this view",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Power, temperature, clocks, activity and VRAM come from AMD's device metrics exporter, which keeps reading a card while it is runtime-suspended (idle). Cards are numbered by the exporter's GPU id: GPU 0 is PCI 0000:23:00.0 and GPU 1 is 0000:c3:00.0 (the exporter enumerates in PCI order). The PCI link and runtime power state come from node-exporter's pcidevice collector, keyed by PCI address. The power state is not a power reading: an idle card in D0 can draw as little as a suspended one, while a card driving a monitor draws more."
      }
    },
    {
      "id": 12,
      "title": "PCI runtime power state",
      "type": "stat",
      "description": "D0 is active; D3hot is runtime-suspended (idle). From node-exporter's pcidevice collector, one value per GPU display function.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(node_pcidevice_power_state{job=\"node\"} == 1) * on(segment,bus,device,function) group_left() node_pcidevice_info{job=\"node\",vendor_id=\"0x1002\",class_id=\"0x030000\"}",
          "legendFormat": "{{segment}}:{{bus}}:{{device}}.{{function}} \u00b7 {{state}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Telemetry unavailable",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 20,
      "title": "Package power \u00b7 each card",
      "type": "timeseries",
      "description": "Average package power. From AMD's device metrics exporter, which reads each card even while it is runtime-suspended; series are matched to the card's PCI address.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (gpu_id) (gpu_average_package_power{job=\"amd-gpu\",gpu_id=~\"${gpu:regex}\"})",
          "legendFormat": "GPU {{gpu_id}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "noValue": "Exporter unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 21,
      "title": "Junction (hotspot) temperature \u00b7 each card",
      "type": "timeseries",
      "description": "Hottest on-die point; the card throttles as this approaches its limit. From AMD's device metrics exporter, which reads each card even while it is runtime-suspended; series are matched to the card's PCI address.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (gpu_id) (gpu_junction_temperature{job=\"amd-gpu\",gpu_id=~\"${gpu:regex}\"})",
          "legendFormat": "GPU {{gpu_id}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "Exporter unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 22,
      "title": "Compute activity \u00b7 each card",
      "type": "timeseries",
      "description": "Graphics/compute engine busy share. From AMD's device metrics exporter, which reads each card even while it is runtime-suspended; series are matched to the card's PCI address.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (gpu_id) (gpu_gfx_activity{job=\"amd-gpu\",gpu_id=~\"${gpu:regex}\"})",
          "legendFormat": "GPU {{gpu_id}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Exporter unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "VRAM used and capacity",
      "type": "timeseries",
      "description": "Separate capacity per GPU; do not treat two cards as one allocation.",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (gpu_id) (gpu_used_vram{job=\"amd-gpu\",gpu_id=~\"${gpu:regex}\"})",
          "legendFormat": "GPU {{gpu_id}} used",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "max by (gpu_id) (gpu_total_vram{job=\"amd-gpu\",gpu_id=~\"${gpu:regex}\"})",
          "legendFormat": "GPU {{gpu_id}} capacity",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 23,
      "title": "Memory and edge temperature \u00b7 each card",
      "type": "timeseries",
      "description": "VRAM (memory) temperature and board edge temperature. From AMD's device metrics exporter, which reads each card even while it is runtime-suspended; series are matched to the card's PCI address.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 7
