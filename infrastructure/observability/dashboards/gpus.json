      },
      "targets": [
        {
          "refId": "A",
          "expr": "workstation_gpu_sensor_available{job=\"node\",pci_bdf=~\"${gpu:regex}\"} and on(job,instance) (time() - workstation_hardware_sample_timestamp_seconds{job=\"node\"} <= 90) and on(job,instance) (workstation_hardware_sample_timestamp_seconds{job=\"node\"} - time() <= 10)",
