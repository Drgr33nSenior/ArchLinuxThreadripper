          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 24,
      "title": "Core and memory clock \u00b7 each card",
      "type": "timeseries",
      "description": "Current core (system) and memory clocks. From AMD's device metrics exporter, which reads each card even while it is runtime-suspended; series are matched to the card's PCI address.",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (gpu_id) (gpu_clock{job=\"amd-gpu\",gpu_id=~\"${gpu:regex}\",clock_type=\"system\"})",
          "legendFormat": "GPU {{gpu_id}} core",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "max by (gpu_id) (gpu_clock{job=\"amd-gpu\",gpu_id=~\"${gpu:regex}\",clock_type=\"memory\"})",
          "legendFormat": "GPU {{gpu_id}} memory",
          "range": true,
