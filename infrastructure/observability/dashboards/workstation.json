  "schemaVersion": 39,
  "version": 1,
  "uid": "workstation-overview",
  "title": "Workstation / Overview",
  "description": "Start with health, headroom and per-card activity; follow links to a focused investigation.",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Start here",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**A quick view of the workstation.** Use the links above for detail. Click a GPU bar to focus on that card. “Unavailable” means the sensor or service has not supplied data; an offline serving endpoint does not mean the GPUs are faulty. GPU activity can be blank while cards are runtime-suspended; open **GPUs** for sensor availability."
      }
    },
    {
      "id": 2,
      "title": "CPU busy",
      "type": "stat",
      "description": "Share of all host logical CPUs that are busy. High activity alone is not a fault.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg(rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "Host CPU",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "links": [
        {
          "title": "Inspect CPU",
          "url": "/d/workstation-host?${__url_time_range}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 3,
      "title": "RAM available",
      "type": "stat",
      "description": "Linux MemAvailable: memory available for new work, including reclaimable cache.",
      "gridPos": {
        "x": 4,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{job=\"node\"}",
          "legendFormat": "Host RAM",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "links": [
        {
          "title": "Inspect memory",
          "url": "/d/workstation-host?${__url_time_range}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 4,
      "title": "Root disk free",
      "type": "stat",
      "description": "Available root-filesystem capacity. PVC requests do not enforce quotas.",
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{job=\"node\",mountpoint=\"/\",fstype=\"xfs\"} / node_filesystem_size_bytes{job=\"node\",mountpoint=\"/\",fstype=\"xfs\"}",
          "legendFormat": "Root filesystem",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "links": [
        {
          "title": "Inspect storage",
          "url": "/d/workstation-host?${__url_time_range}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 5,
      "title": "PSU DC output",
      "type": "stat",
      "description": "Measured PSU output, excluding conversion losses. Not AC wall power.",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "workstation_psu_output_power_watts{job=\"node\"} and on(job,instance) (workstation_psu_available{job=\"node\"} == 1) and on(job,instance) (time() - workstation_psu_sample_timestamp_seconds{job=\"node\"} <= 90) and on(job,instance) (workstation_psu_sample_timestamp_seconds{job=\"node\"} - time() <= 10)",
          "legendFormat": "PSU",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "links": [
        {
          "title": "Inspect power",
          "url": "/d/workstation-power?${__url_time_range}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 6,
      "title": "Serving endpoint",
      "type": "stat",
      "description": "Reports reachability of the configured SGLang metrics endpoint, not model quality.",
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"sglang\"}",
          "legendFormat": "SGLang",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Offline / unreachable",
                  "color": "text",
                  "index": 0
                },
                "1": {
                  "text": "Online",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "links": [
        {
          "title": "Inspect serving",
          "url": "/d/workstation-workloads?${__url_time_range}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 7,
      "title": "Firing alerts",
      "type": "stat",
      "description": "Number of rules currently firing in Prometheus. Zero means no firing rule; it does not qualify every sensor.",
      "gridPos": {
        "x": 20,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "Alerts",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "links": [
        {
          "title": "Inspect alerts",
          "url": "/d/workstation-monitoring?${__url_time_range}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 8,
      "title": "GPU activity · each card",
      "type": "bargauge",
      "description": "Sampled hardware busy percentage. This is not tensor utilization and may miss short bursts.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "workstation_gpu_busy_percent{job=\"node\"} / 100 and on(job,instance) (time() - workstation_hardware_sample_timestamp_seconds{job=\"node\"} <= 90) and on(job,instance) (workstation_hardware_sample_timestamp_seconds{job=\"node\"} - time() <= 10)",
          "legendFormat": "{{pci_bdf}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          },
          "min": 0,
          "max": 1,
          "links": [
            {
              "title": "Inspect this GPU",
              "url": "/d/workstation-gpus?var-gpu=${__field.labels.pci_bdf}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "valueMode": "color",
        "namePlacement": "auto"
      },
      "links": [
        {
          "title": "GPU details",
          "url": "/d/workstation-gpus?${__url_time_range}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 9,
      "title": "VRAM occupied · each card",
      "type": "bargauge",
      "description": "Each GPU has its own allocation domain. This is physical VRAM use, not the SGLang KV-pool ratio.",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "workstation_gpu_vram_used_bytes{job=\"node\"} / workstation_gpu_vram_total_bytes{job=\"node\"} and on(job,instance) (time() - workstation_hardware_sample_timestamp_seconds{job=\"node\"} <= 90) and on(job,instance) (workstation_hardware_sample_timestamp_seconds{job=\"node\"} - time() <= 10)",
          "legendFormat": "{{pci_bdf}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          },
          "min": 0,
          "max": 1,
          "links": [
            {
              "title": "Inspect this GPU",
              "url": "/d/workstation-gpus?var-gpu=${__field.labels.pci_bdf}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "valueMode": "color",
        "namePlacement": "auto"
      },
      "links": [
        {
          "title": "GPU details",
          "url": "/d/workstation-gpus?${__url_time_range}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 10,
      "title": "CPU activity over time",
      "type": "timeseries",
      "description": "Use Host & storage to distinguish busy CPUs from CPU, memory or I/O pressure.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg(rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "Host CPU",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [
        {
          "title": "Inspect host",
          "url": "/d/workstation-host?${__url_time_range}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 11,
      "title": "RAM available over time",
      "type": "timeseries",
      "description": "Use Workloads & serving to find container memory consumers.",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{job=\"node\"}",
          "legendFormat": "Host RAM",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [
        {
          "title": "Inspect workloads",
          "url": "/d/workstation-workloads?${__url_time_range}",
          "targetBlank": false
        }
      ]
    }
  ]
}
