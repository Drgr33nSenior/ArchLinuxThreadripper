{
  "uid": "workstation-overview",
  "title": "Workstation: host, serving and telemetry",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "workstation",
    "unqualified"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Available host RAM",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "{{job}} {{instance}} {{pod}} {{chip}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Memory pressure (5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_pressure_memory_waiting_seconds_total[5m])",
          "legendFormat": "{{job}} {{instance}} {{pod}} {{chip}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "CPU utilisation",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "{{job}} {{instance}} {{pod}} {{chip}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "XFS available bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{fstype=\"xfs\"}",
          "legendFormat": "{{job}} {{instance}} {{pod}} {{chip}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "CPU scaling frequency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "hertz"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_cpu_scaling_frequency_hertz",
          "legendFormat": "{{job}} {{instance}} {{pod}} {{chip}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Reported hardware temperatures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_hwmon_temp_celsius",
          "legendFormat": "{{job}} {{instance}} {{pod}} {{chip}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Pod restarts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_container_status_restarts_total",
          "legendFormat": "{{job}} {{instance}} {{pod}} {{chip}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Container requested memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_container_resource_requests{resource=\"memory\"}",
          "legendFormat": "{{job}} {{instance}} {{pod}} {{chip}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "SGLang queued requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sglang:num_queue_reqs{job=\"sglang\",priority=\"\"}",
          "legendFormat": "{{job}} {{instance}} {{pod}} {{chip}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "SGLang TTFT p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le)(rate(sglang:time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "{{job}} {{instance}} {{pod}} {{chip}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "SGLang inter-token p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le)(rate(sglang:inter_token_latency_seconds_bucket[5m])))",
          "legendFormat": "{{job}} {{instance}} {{pod}} {{chip}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "title": "Telemetry target availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}} {{instance}} {{pod}} {{chip}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 101,
      "type": "timeseries",
      "title": "Per-card VRAM usage",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 48, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "workstation_gpu_vram_used_bytes", "legendFormat": "{{pci_bdf}} used"},
        {"refId": "B", "expr": "workstation_gpu_vram_total_bytes", "legendFormat": "{{pci_bdf}} total"}
      ]
    },
    {
      "id": 102,
      "type": "timeseries",
      "title": "Per-card temperatures (supported sensors only)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 48, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "celsius"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "workstation_gpu_temperature_celsius", "legendFormat": "{{pci_bdf}} {{sensor}}"}]
    },
    {
      "id": 103,
      "type": "timeseries",
      "title": "Per-card reported power (not wall power)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 56, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "watt"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "workstation_gpu_power_average_watts", "legendFormat": "{{pci_bdf}} average"}]
    },
    {
      "id": 104,
      "type": "timeseries",
      "title": "GPU inventory and sample age",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 56, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "workstation_gpu_count", "legendFormat": "cards discovered"},
        {"refId": "B", "expr": "time() - workstation_hardware_sample_timestamp_seconds", "legendFormat": "sample age seconds"}
      ]
    },
    {
      "id": 100,
      "type": "text",
      "title": "Qualification and evidence",
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "No data is unavailable, not zero. GPU counters and SGLang metric schemas require qualification against the installed versions. This dashboard does not prove GPU correctness, thermal stability or speedup. Alerts are visible in Prometheus; external notification routing is an owner configuration step. Compare benchmark runs with identical model/configuration identity. Raw prompts, arbitrary pod logs and credentials are not collected."
      }
    }
  ]
}
