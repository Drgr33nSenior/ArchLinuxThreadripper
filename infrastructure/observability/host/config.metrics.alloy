// Metrics-only host Alloy profile. It deliberately has no journal, Loki, log
// or trace pipeline. Replace the documentation address only in an owner review.
logging {
  level = "warn"
  format = "json"
}

prometheus.scrape "self" {
  targets = [{"__address__" = "127.0.0.1:12345", "job" = "workstation-host-alloy"}]
  scrape_interval = "30s"
  scrape_timeout = "10s"
  sample_limit = 12000
  label_limit = 32
  label_value_length_limit = 256
  body_size_limit = "8MiB"
  forward_to = [prometheus.relabel.self.receiver]
}

// Optional native SGLang endpoint, configured by the owner. Empty, non-loopback
// and invalid-port values produce no targets. Never expose inference to the LAN.
discovery.relabel "sglang_local" {
  targets = [{"__address__" = sys.env("WORKSTATION_SGLANG_METRICS_ADDRESS"), "job" = "sglang"}]
  rule {
    source_labels = ["__address__"]
    regex = "127[.]0[.]0[.]1:([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])"
    action = "keep"
  }
}

prometheus.scrape "sglang_local" {
  targets = discovery.relabel.sglang_local.output
  scrape_interval = "30s"
  scrape_timeout = "5s"
  sample_limit = 12000
  label_limit = 32
  label_value_length_limit = 256
  body_size_limit = "8MiB"
  forward_to = [prometheus.relabel.sglang_local.receiver]
}

prometheus.relabel "sglang_local" {
  // SGLang's negotiated exposition can escape the colon prefix to an
  // underscore. Normalize only this job before the family allowlist.
  rule {
    action = "replace"
    source_labels = ["job", "__name__"]
    regex = "sglang;sglang_(.+)"
    target_label = "__name__"
    replacement = "sglang:$1"
  }
  rule {
    action = "keep"
    source_labels = ["__name__"]
    regex = "(up|scrape_.*|sglang:.*)"
  }
  rule {
    action = "labeldrop"
    regex = "(request_id|session_id|turn_id|user_id|prompt|completion|token|authorization|cookie)"
  }
  forward_to = [prometheus.remote_write.self.receiver]
}

prometheus.relabel "self" {
  rule {
    action = "keep"
    source_labels = ["__name__"]
    regex = "(alloy_build_info|up|otelcol_.*|prometheus_remote_storage_.*)"
  }
  forward_to = [prometheus.remote_write.self.receiver]
}

prometheus.remote_write "self" {
  endpoint {
    url = "http://192.0.2.5:9090/api/v1/write"
    queue_config {
      capacity = 64
      min_shards = 1
      max_shards = 1
      max_samples_per_send = 128
      batch_send_deadline = "5s"
    }
  }
  wal {
    truncate_frequency = "15m"
    min_keepalive_time = "5m"
    max_keepalive_time = "30m"
  }
}

otelcol.receiver.otlp "bridge" {
  http {
    endpoint = "127.0.0.1:4318"
    max_request_body_size = "4MiB"
  }
  output {
    metrics = [otelcol.processor.memory_limiter.host.input]
  }
}

otelcol.processor.memory_limiter "host" {
  check_interval = "1s"
  limit = "256MiB"
  spike_limit = "32MiB"
  output {
    metrics = [otelcol.processor.batch.host.input]
  }
}

otelcol.processor.batch "host" {
  timeout = "5s"
  send_batch_size = 128
  send_batch_max_size = 256
  output {
    metrics = [otelcol.exporter.otlphttp.cluster.input]
  }
}

otelcol.exporter.otlphttp "cluster" {
  client {
    endpoint = "http://192.0.2.4:4318"
    timeout = "5s"
  }
  sending_queue {
    queue_size = 64
    num_consumers = 1
  }
  retry_on_failure {
    max_elapsed_time = "30s"
  }
}
