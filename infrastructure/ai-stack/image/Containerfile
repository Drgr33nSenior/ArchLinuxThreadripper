# gfx1201 SGLang serving runtime. Installs exactly the wheelhouse the sglang
# stage resolved, offline; the ROCm SDK comes from its Python packages, so the
# image needs no system ROCm. Build context: the sglang stage's out/ directory.
ARG RUNTIME_BASE_IMAGE
FROM ${RUNTIME_BASE_IMAGE}
ARG STACK_ID
# The wheels bundle ROCm but not the GCC runtime libraries: torch needs
# libgomp (OpenMP) and part of the wheelhouse needs libatomic. Triton compiles
# its HIP launcher with the system C compiler at runtime (gcc, libc6-dev).
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgomp1 libatomic1 gcc libc6-dev \
 && rm -rf /var/lib/apt/lists/*
RUN --mount=type=bind,source=wheelhouse,target=/wheelhouse \
    python3 -m pip install --no-cache-dir --no-index --find-links /wheelhouse /wheelhouse/*.whl \
 && python3 -m pip check
# The devel SDK ships as a tarball that rocm-sdk unpacks on first use, which a
# read-only pod root cannot do; unpack it here (it deletes the tarball).
RUN rocm-sdk init >/dev/null \
 && test -d "$(rocm-sdk path --root)/include/hip" \
 && ! test -e /usr/local/lib/python3.14/site-packages/rocm_sdk_devel/_devel.tar
# Toolchain for Triton and SGLang JIT: the packaged TheRock SDK, not /opt/rocm.
# The python3.14 path follows PYTHON_ABI in stack.lock.
ENV ROCM_HOME=/usr/local/lib/python3.14/site-packages/_rocm_sdk_devel \
    ROCM_PATH=/usr/local/lib/python3.14/site-packages/_rocm_sdk_devel \
    LLVM_PATH=/usr/local/lib/python3.14/site-packages/_rocm_sdk_core/lib/llvm \
    HIP_CLANG_PATH=/usr/local/lib/python3.14/site-packages/_rocm_sdk_core/lib/llvm/bin \
    HIP_PLATFORM=amd \
    HIP_COMPILER=clang \
    PATH=/usr/local/lib/python3.14/site-packages/_rocm_sdk_core/bin:/usr/local/bin:/usr/bin:/bin
COPY RECEIPT.json /usr/share/ai-stack/sglang-receipt.json
COPY stack.lock /usr/share/ai-stack/stack.lock
# hipBLASLt for the remaining BF16 GEMMs (PyTorch's gfx1201 default, made
# explicit); the op234 ROCBLAS_USE_HIPBLASLT=-1 is undocumented and dropped.
ENV TORCH_BLAS_PREFER_HIPBLASLT=1 \
    HF_HUB_OFFLINE=1
LABEL org.opencontainers.image.title="sglang-gfx1201" \
      org.opencontainers.image.revision="${STACK_ID}"
ENTRYPOINT ["python3", "-m", "sglang.launch_server"]
