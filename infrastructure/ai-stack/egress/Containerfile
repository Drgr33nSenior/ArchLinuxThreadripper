# The workspace egress proxy image, from the egress stage's outputs (build context: its
# out/). One static binary and nothing else: no shell, package manager or libc, so the
# image has no operating-system packages to patch. The proxy only tunnels and forwards;
# it terminates no TLS and so carries no CA bundle. Runs as an unprivileged numeric user.
FROM scratch
COPY bin/sandbox-egress /sandbox-egress
COPY LICENSE.txt RECEIPT.json buildinfo.txt /usr/share/doc/sandbox-egress/
USER 65532:65532
ENTRYPOINT ["/sandbox-egress"]
