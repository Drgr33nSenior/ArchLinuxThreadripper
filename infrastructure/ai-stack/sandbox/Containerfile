ARG RUNTIME_BASE_IMAGE
FROM ${RUNTIME_BASE_IMAGE}
ARG PLAYWRIGHT_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs npm git curl jq ripgrep bash coreutils findutils procps unzip zip \
    ca-certificates build-essential tini libatomic1 \
    && rm -rf /var/lib/apt/lists/*
COPY terminal-source /src/open-terminal
COPY terminals-source /src/terminals
RUN pip install --no-cache-dir /src/open-terminal /src/terminals playwright==${PLAYWRIGHT_VERSION} \
    && playwright install --with-deps chromium \
    && mkdir -p /opt/sandbox /opt/licenses \
    && cp /src/open-terminal/LICENSE /opt/licenses/open-terminal.txt \
    && cp /src/terminals/LICENSE /opt/licenses/terminals.txt \
    && pip freeze --all > /opt/sandbox/packages.txt \
    && useradd --uid 1000 --create-home --shell /bin/bash user
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
# The installer above uses the build user's cache; relocate it to a read-only image path.
RUN mv /root/.cache/ms-playwright /opt/playwright \
    && chmod -R a+rX /opt/playwright \
    && ln -s /opt/playwright/chromium-*/chrome-linux64/chrome /usr/local/bin/chromium
COPY --chmod=0644 control.py terminal.py smoke.py /opt/sandbox/
RUN OPEN_TERMINAL_API_KEY=build-fixture-not-a-credential python -c \
    'import json; from open_terminal.main import app; open("/opt/sandbox/openapi.json", "w").write(json.dumps(app.openapi()))'
ENV HOME=/home/user USER=user TMPDIR=/tmp PYTHONDONTWRITEBYTECODE=1
USER 1000:1000
WORKDIR /home/user
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "/opt/sandbox/terminal.py"]
