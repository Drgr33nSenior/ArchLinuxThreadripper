# K3s v1.36 kubelet drop-in, read after K3s's own 00-k3s-defaults.conf (which sets
# imageMaximumGCAge: 0s, so unused images are otherwise kept until the disk is 85% full).
# The kubelet removes images no container has used for this long; the registry keeps
# every pushed build. "0s" restores the K3s default.
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
imageMaximumGCAge: {{ lab_image_maximum_gc_age | to_json }}
