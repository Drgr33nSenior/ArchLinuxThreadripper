#!/usr/sbin/nft -f
# Host guard for single-node K3s. Owns only this table: it never flushes the
# ruleset, so K3s/kube-proxy/flannel rules are untouched. `destroy` and the
# re-creation below are one nft transaction. Other traffic (including SSH) is
# left to the existing policy. Nothing here accepts traffic on any interface
# other than {{ lab_network_interface }}; a future DMZ NIC gets no service.
destroy table inet k3s_host_guard
table inet k3s_host_guard {
  # Kubernetes API clients: the management network only.
  set api_clients_v4 {
    type ipv4_addr
    flags interval
    elements = { {{ lab_management_cidr }} }
  }

  # In-cluster API callers: Pods and Services.
  set cluster_v4 {
    type ipv4_addr
    flags interval
    elements = { {{ lab_cluster_cidr }}, {{ lab_service_cidr }} }
  }

  # HTTPS clients of Traefik (the site's client_cidrs). Empty admits none.
  set https_clients_v4 {
    type ipv4_addr
    flags interval
{% if lab_https_client_cidrs | length > 0 %}
    elements = { {{ lab_https_client_cidrs | join(', ') }} }
{% endif %}
  }

  chain https_pre_dnat {
    # Runs before nat prerouting (-100). kube-proxy DNATs the Traefik
    # externalIP {{ lab_node_ip }}:443 to the Pod, so an input-hook rule would
    # never see this traffic. Drop 443 to every local address unless it is
    # the node address on the management VLAN from an approved client.
    type filter hook prerouting priority -150; policy accept;
    iifname "{{ lab_network_interface }}" ip daddr {{ lab_node_ip }} ip saddr @https_clients_v4 tcp dport 443 accept
    fib daddr type local tcp dport 443 counter drop
  }

  chain input {
    type filter hook input priority filter - 10; policy accept;
    iifname "lo" accept
    # Kubernetes API (supervisor and apiserver share 6443).
    iifname "{{ lab_network_interface }}" ip daddr {{ lab_node_ip }} ip saddr @api_clients_v4 tcp dport 6443 accept
    tcp dport 6443 ip saddr @cluster_v4 accept
    tcp dport 6443 counter drop
    # Kubelet: the local apiserver (via lo) and in-cluster pods only.
    tcp dport 10250 ip saddr {{ lab_cluster_cidr }} accept
    tcp dport 10250 counter drop
    # Flannel VXLAN: single node, so no peer may send encapsulated traffic.
    udp dport 8472 counter drop
  }
}
