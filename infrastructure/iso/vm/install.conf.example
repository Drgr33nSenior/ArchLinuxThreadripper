# QEMU storage/boot test only. Resolve the actual two by-id links in the guest.
VM_TEST_MODE=true
HOSTNAME=archlab-test
HOST_PROFILE=headless
USERNAME=operator
LOCALE=en_GB.UTF-8
KEYMAP=uk
TIMEZONE=Europe/London
PRIMARY_DISK=/dev/disk/by-id/nvme-REPLACE_QEMU_A
SECONDARY_DISK=/dev/disk/by-id/nvme-REPLACE_QEMU_B
PRIMARY_DISK_SERIAL=ARCHLAB_TEST_A
SECONDARY_DISK_SERIAL=ARCHLAB_TEST_B
RAID_NAME=vm-root
RAID_DEVICE=/dev/md0
LUKS_NAME=crypt_root
ESP_SIZE_MIB=2048
RAID_CHUNK_KIB=512
LUKS_ITER_TIME_MS=2000
LUKS_MEMORY_KIB=1048576
LUKS_PARALLEL=4
BOOT_UNLOCK=tpm2-pin
ALLOW_DISCARDS=true
PRIMARY_ESP_MOUNT=/efi
SECONDARY_ESP_MOUNT=/efi2
ENABLE_SSH=false
ENABLE_BLUETOOTH=false
ENABLE_PRINTING=false
