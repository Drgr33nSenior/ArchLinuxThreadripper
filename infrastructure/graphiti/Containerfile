# Graphiti memory service. Built, scanned, signed and pushed by the AI-stack graphiti
# stage (AI_STACK_PUSH=1 infrastructure/ai-stack/build-stage.sh graphiti); set the pushed
# digest in apps/components/memory/kustomization.yaml.
# Dependencies install only from the hashed lock; no source build or network
# access is needed at runtime.
FROM docker.io/library/python:3.14.10-slim@sha256:af8a5aa14780025dbfbcfbc81bd8a91ebd87711dd5b0f48ed71090949dd7cb1d
COPY requirements-python314.lock /opt/memory/requirements.lock
RUN python -m pip install --no-cache-dir --require-hashes --only-binary=:all: --no-deps \
        -r /opt/memory/requirements.lock \
    && useradd --uid 1000 --no-create-home --shell /usr/sbin/nologin memory
COPY memory_service.py /opt/memory/memory_service.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 GRAPHITI_TELEMETRY_ENABLED=false POSTHOG_DISABLED=1
USER 1000:1000
WORKDIR /opt/memory
EXPOSE 8000
ENTRYPOINT ["python", "-I", "/opt/memory/memory_service.py"]
