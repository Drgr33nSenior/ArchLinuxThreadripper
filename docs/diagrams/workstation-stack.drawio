        <mxCell id="host-gpu" value="&lt;b&gt;Host GPU ownership / userspace&lt;/b&gt;&lt;br&gt;Upstream amdgpu + firmware&lt;br&gt;Mesa / RADV Vulkan&lt;br&gt;Official Arch ROCm / HIP / PyTorch&lt;br&gt;Kernel and framework tests required" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#174c43;fillColor=#e6f4ef;strokeColor=#4b8a79;strokeWidth=1.5;" vertex="1" parent="host">
