        <mxCell id="application-note" value="ClusterIP services + persistent PVCs. Gaming image, display, input, audio and encoding remain unqualified." style="text;html=0;align=left;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#654915;" vertex="1" parent="applications">
