        </mxCell>
        <mxCell id="arch" value="&lt;b&gt;Arch Linux host&lt;/b&gt;&lt;br&gt;Headless / systemd by default&lt;br&gt;Stable + LTS signed boot paths&lt;br&gt;Native git kernel: gated promotion&lt;br&gt;No swap / zram / hibernation" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#173653;fillColor=#eaf2fb;strokeColor=#6089b2;strokeWidth=1.5;" vertex="1" parent="host">
