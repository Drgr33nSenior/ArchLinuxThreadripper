        <mxCell id="gpu-operator" value="&lt;b&gt;AMD GPU Operator v1.5.1&lt;/b&gt;&lt;br&gt;Traditional device plugin + labels&lt;br&gt;amd.com/gpu: exclusive counts&lt;br&gt;Plugin chooses physical GPU&lt;br&gt;&lt;b&gt;Driver management OFF&lt;/b&gt;&lt;br&gt;AMD DRA / KMM OFF" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#174c43;fillColor=#e6f4ef;strokeColor=#4b8a79;strokeWidth=1.5;" vertex="1" parent="k3s">
