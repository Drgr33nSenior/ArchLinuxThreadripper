        <mxCell id="pvc" value="&lt;b&gt;Local-path persistent volumes&lt;/b&gt;&lt;br&gt;LLM models + Hugging Face cache&lt;br&gt;Creative models / outputs&lt;br&gt;WebUI data + gaming home / shaders&lt;br&gt;Node-local · not replicated&lt;br&gt;PVC deletion / retention needs review" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#513d70;fillColor=#f0eaf8;strokeColor=#8b73aa;strokeWidth=1.5;" vertex="1" parent="k3s">
          <mxGeometry x="710" y="352" width="330" height="164" as="geometry" />
        </mxCell>
        <mxCell id="controls" value="&lt;b&gt;Explicit workstation controls&lt;/b&gt;&lt;br&gt;workstationctl: discover · budget · diagnose&lt;br&gt;Sessions: ai / gaming / maintenance / restore&lt;br&gt;Stop managed AI; verify GPU release first&lt;br&gt;Serialised transitions + qualification gates&lt;br&gt;No concurrent AI + gaming guarantee" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#173653;fillColor=#eaf2fb;strokeColor=#6089b2;strokeWidth=1.5;" vertex="1" parent="host">
          <mxGeometry x="1150" y="60" width="460" height="170" as="geometry" />
        </mxCell>
        <mxCell id="native-builds" value="&lt;b&gt;Native development / measurements&lt;/b&gt;&lt;br&gt;llama.cpp: same-source HIP / Vulkan builds&lt;br&gt;Native CPU targets only on target hardware&lt;br&gt;RAM-bounded jobs + persistent ccache&lt;br&gt;TheRock source plan; full build still pending&lt;br&gt;Direct host diagnostics, separate from K3s apps" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#173653;fillColor=#eaf2fb;strokeColor=#6089b2;strokeWidth=1.5;" vertex="1" parent="host">
          <mxGeometry x="1150" y="280" width="460" height="170" as="geometry" />
        </mxCell>
        <mxCell id="vm-lab" value="&lt;b&gt;OPTIONAL · separate KVM lab&lt;/b&gt;&lt;br&gt;libvirt / KVM → AlmaLinux → K3s&lt;br&gt;Embedded etcd (not bare-metal SQLite)&lt;br&gt;Defaults: 8 vCPU / 16 GiB RAM&lt;br&gt;Management NAT + DMZ NIC&lt;br&gt;No R9700 passthrough in this profile" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#4d5562;fillColor=#f4f5f7;strokeColor=#808b9b;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="host">
