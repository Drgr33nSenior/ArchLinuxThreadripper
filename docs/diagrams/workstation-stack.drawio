        <mxCell id="host" value="ONE PHYSICAL WORKSTATION  ·  Arch host owns the GPUs, storage and optional virtual machines" style="swimlane;html=0;startSize=40;horizontal=1;rounded=1;arcSize=6;whiteSpace=wrap;align=left;spacingLeft=18;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#173653;fillColor=#e8eef6;swimlaneFillColor=#f8fafc;strokeColor=#8aa0b9;strokeWidth=2;" vertex="1" parent="1">
