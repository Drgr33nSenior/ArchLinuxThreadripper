        <mxCell id="repository" value="&lt;b&gt;REPOSITORY / INSTALLER INPUTS&lt;/b&gt;&lt;br&gt;config/*.conf + versions.lock&lt;br&gt;Generic ISO / signed packages → USB installer&lt;br&gt;Ansible · Kustomize · Helm" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#173653;fillColor=#eaf2fb;strokeColor=#6089b2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1190" y="195" width="460" height="100" as="geometry" />
