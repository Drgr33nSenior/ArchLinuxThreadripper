        <mxCell id="runtime" value="&lt;b&gt;K3s runtime / network&lt;/b&gt;&lt;br&gt;v1.35.7+k3s1 · containerd 2.x&lt;br&gt;Flannel · CoreDNS · NetworkPolicy&lt;br&gt;Traefik; ServiceLB disabled&lt;br&gt;External exposure still gated&lt;br&gt;Static CPU Manager: opt-in" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#173653;fillColor=#eaf2fb;strokeColor=#6089b2;strokeWidth=1.5;" vertex="1" parent="k3s">
