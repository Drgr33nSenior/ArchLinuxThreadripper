        <mxCell id="clients" value="&lt;b&gt;INTENDED CLIENT PATHS / REMOTE DEVELOPMENT&lt;/b&gt;&lt;br&gt;Browser → Open WebUI (gated) · Moonlight ↔ Sunshine · Steam Remote Play&lt;br&gt;Client Mac: development tools and opt-in SSH access" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#173653;fillColor=#eaf2fb;strokeColor=#6089b2;strokeWidth=1.5;" vertex="1" parent="1">
