        <mxCell id="status" value="REPOSITORY DEPLOYMENT VIEW  |  7 September 2026&#xa;Source-defined configuration, not a running-system discovery. AI / gaming images and target hardware still require qualification." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=left;spacingLeft=18;fontFamily=Helvetica;fontSize=17;fontColor=#6b4200;fillColor=#fff4d6;strokeColor=#b98928;strokeWidth=1.5;" vertex="1" parent="1">
