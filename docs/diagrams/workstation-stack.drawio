        <mxCell id="webui" value="&lt;b&gt;Open WebUI&lt;/b&gt;&lt;br&gt;Chat interface&lt;br&gt;Internal LLM API client&lt;br&gt;No GPU request" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#173653;fillColor=#ffffff;strokeColor=#b98928;strokeWidth=1.5;dashed=1;" vertex="1" parent="applications">
