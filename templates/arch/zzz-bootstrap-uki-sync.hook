# Runs after Arch's 90-mkinitcpio-install.hook and zz-sbctl.hook. Mirror
# mkinitcpio's regeneration triggers; our helper signs the exact primary UKIs
# itself because sbctl does not necessarily run for every initramfs dependency.
# Recheck this list when upgrading mkinitcpio (upstream hooks are authoritative).
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/lib/initcpio/*
Target = usr/lib/firmware/*
Target = usr/lib/modules/*/extramodules/
Target = usr/src/*/dkms.conf
Target = usr/lib/systemd/systemd
Target = usr/lib/systemd/systemd-udevd
Target = usr/bin/cryptsetup
Target = usr/bin/lvm
Target = usr/bin/mdadm
Target = usr/bin/pdata_tools
Target = usr/lib/libcryptsetup.so
Target = usr/lib/libp11-kit.so
Target = usr/lib/libpcsclite.so
Target = usr/lib/modprobe.d/

[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/modules/*/vmlinuz

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = linux
Target = linux-lts
Target = amd-ucode
Target = mkinitcpio
Target = mkinitcpio-git

[Action]
Description = Signing and verifying rebuilt UKIs and synchronising the backup ESP
When = PostTransaction
Exec = /usr/lib/arch-workstation-bootstrap/uki-sync --sign
Depends = sbctl
Depends = sbsigntools
