# Reviewed linux-git build overlay.  The pinned AUR recipe appends this file to
# its generated config before `make olddefconfig`; do not put user-space CFLAGS
# or makepkg settings here.
CONFIG_X86_NATIVE_CPU=y
# PCI_P2PDMA alone does not enable amdgpu/KFD peer admission.
CONFIG_PCI_P2PDMA=y
CONFIG_HSA_AMD_P2P=y
# This exact dual-R9700 profile does not contain these other GPU families.
# Keep amdgpu, simpledrm, VKMS, USB/display recovery and all security controls.
# CONFIG_DRM_I915 is not set
# CONFIG_DRM_XE is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_RADEON is not set
